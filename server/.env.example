# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/smart_task_allocation

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30m

# Frontend URL (used in password reset emails)
CLIENT_URL=http://localhost:5173

# Email (SendGrid) - leave blank for dev (reset link is logged to console instead)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@smarttaskallocation.com

# Stripe - leave blank for prototype
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
