# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/smart_task_allocation

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30m

# Email (SendGrid) - leave blank for prototype
SENDGRID_API_KEY=
FROM_EMAIL=noreply@smarttaskallocation.com

# Stripe - leave blank for prototype
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
