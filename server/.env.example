# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/smart_task_allocation

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30m

# Frontend URL (used in password reset emails)
CLIENT_URL=http://localhost:5173

# Email (SendGrid)
#
# Leave SENDGRID_API_KEY blank for dev: password-reset and email-verification links
# are logged to the server console instead of being sent. Recover a verification
# link that has scrolled away with:  npm run verify:links
#
# To send for real, FROM_EMAIL must EXACTLY match an address you have verified in
# SendGrid (Settings -> Sender Authentication -> Verify a Single Sender). Sending
# from an unverified address fails with "403 - does not match a verified Sender
# Identity". The default below is a placeholder domain nobody owns, so change it.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@smarttaskallocation.com

# Stripe - leave blank for prototype
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
