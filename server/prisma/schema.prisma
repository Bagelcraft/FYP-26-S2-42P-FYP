generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────

enum UserType {
  SYSTEM_ADMIN
  ORG_ADMIN
  PROJECT_MANAGER
  PERMANENT_WORKER
  TEMPORARY_WORKER
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  ON_LEAVE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum AssignmentType {
  MANUAL
  AUTO
}

enum LeaveType {
  ANNUAL
  MEDICAL
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingStatus {
  PAID
  UNPAID
  REFUNDED
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

enum ShiftChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UpdateRequestStatus {
  PENDING
  RESPONDED
}

// ─── Organisation & Subscription ─────────────────────────────

model Organisation {
  organisation_id        Int      @id @default(autoincrement())
  active_subscription_id Int?     @unique
  name                   String   @db.VarChar(150)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  activeSubscription Subscription?  @relation("ActiveSubscription", fields: [active_subscription_id], references: [subscription_id])
  subscriptions      Subscription[] @relation("OrgSubscriptions")
  users              User[]
  departments        Department[]
  skills             Skill[]
  tasks              Task[]
  staffRoles         StaffRole[]
  unregisteredUsers  UnregisteredUser[]
  shiftTemplates     ShiftTemplate[]
  shiftAssignments   ShiftAssignment[]
}

model Subscription {
  subscription_id Int                @id @default(autoincrement())
  organisation_id Int
  amount          Decimal            @db.Decimal(10, 2)
  start_date      DateTime           @db.Date
  end_date        DateTime           @db.Date
  status          SubscriptionStatus @default(ACTIVE)

  organisation          Organisation @relation("OrgSubscriptions", fields: [organisation_id], references: [organisation_id])
  activeForOrganisation Organisation? @relation("ActiveSubscription")
  billingRecords        BillingRecord[]
}

model BillingRecord {
  billing_id      Int           @id @default(autoincrement())
  subscription_id Int
  amount          Decimal       @db.Decimal(10, 2)
  billing_date    DateTime      @db.Date
  receipt_url     String?       @db.VarChar(500)
  status          BillingStatus @default(UNPAID)

  subscription    Subscription  @relation(fields: [subscription_id], references: [subscription_id])
}

// ─── Staff Roles ──────────────────────────────────────────────

model StaffRole {
  role_id           Int    @id @default(autoincrement())
  organisation_id   Int
  role_name         String @db.VarChar(100)
  max_working_hours Int?

  organisation      Organisation @relation(fields: [organisation_id], references: [organisation_id])
  users             User[]
}

// ─── Users ───────────────────────────────────────────────────

model User {
  userId         Int       @id @default(autoincrement())
  organisationId Int?
  role_id        Int?
  full_name      String    @db.VarChar(100)
  email          String    @unique @db.VarChar(150)
  password_hash  String    @db.VarChar(255)
  user_type      UserType
  is_active      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastLogin      DateTime?

  organisation       Organisation?        @relation(fields: [organisationId], references: [organisation_id])
  staffRole          StaffRole?           @relation(fields: [role_id], references: [role_id])
  skills             UserSkill[]
  attendance         Attendance[]
  availability       Availability[]
  createdTasks       Task[]               @relation("CreatedTasks")
  assignedTasks      TaskAssignment[]     @relation("AssignedTo")
  taskAssignedBy     TaskAssignment[]     @relation("AssignedBy")
  leaveRequests      LeaveRequest[]       @relation("UserLeave")
  approvedLeave      LeaveRequest[]       @relation("ApprovedLeave")
  leaveBalance       LeaveBalance[]
  shiftRequests      ShiftChangeRequest[] @relation("UserShiftChange")
  shiftAssignments   ShiftAssignment[]
  reviewedShifts     ShiftChangeRequest[] @relation("ReviewedShiftChange")
  allocationHistory  AllocationHistory[]  @relation("UserAllocation")
  changedAllocations AllocationHistory[]  @relation("ChangedByAllocation")
  sentUpdateRequests TaskUpdateRequest[]  @relation("UpdateRequestedBy")
  feedback           Feedback[]
  testimonials       Testimonial[]
  headOfDepts        Department[]         @relation("DeptHead")
  notifications           Notification[]
  profileChangeRequests   ProfileChangeRequest[] @relation("ProfileChangeRequests")
  profileChangeReviews    ProfileChangeRequest[] @relation("ProfileChangeReviews")
}

// ─── Department ───────────────────────────────────────────────

model Department {
  department_id   Int    @id @default(autoincrement())
  organisation_id Int
  head_user_id    Int?
  name            String @db.VarChar(100)

  organisation    Organisation @relation(fields: [organisation_id], references: [organisation_id])
  head            User?        @relation("DeptHead", fields: [head_user_id], references: [userId])
  tasks           Task[]
}

// ─── Skills ───────────────────────────────────────────────────

model Skill {
  skill_id        Int     @id @default(autoincrement())
  organisation_id Int
  skill_name      String  @db.VarChar(100)
  cert_required   Boolean @default(false)

  organisation    Organisation @relation(fields: [organisation_id], references: [organisation_id])
  userSkills      UserSkill[]
  tasks           Task[]
  taskSkills      TaskSkill[]
}

model UserSkill {
  user_skill_id     Int     @id @default(autoincrement())
  user_id           Int
  skill_id          Int
  certification_url String? @db.VarChar(500)

  user              User  @relation(fields: [user_id], references: [userId])
  skill             Skill @relation(fields: [skill_id], references: [skill_id])
}

// ─── Attendance & Availability ────────────────────────────────

model Attendance {
  attendance_id Int       @id @default(autoincrement())
  user_id       Int
  clock_in      DateTime
  clock_out     DateTime?
  working_hours Decimal?  @db.Decimal(5, 2)

  user          User      @relation(fields: [user_id], references: [userId])
}

model Availability {
  availability_id Int                @id @default(autoincrement())
  user_id         Int
  start_datetime  DateTime
  end_datetime    DateTime
  status          AvailabilityStatus

  user            User               @relation(fields: [user_id], references: [userId])
}

// ─── Leave ───────────────────────────────────────────────────

model LeaveRequest {
  leave_id    Int         @id @default(autoincrement())
  user_id     Int
  approved_by Int?
  leave_type  LeaveType
  start_date  DateTime    @db.Date
  end_date    DateTime    @db.Date
  status      LeaveStatus @default(PENDING)

  user        User        @relation("UserLeave", fields: [user_id], references: [userId])
  approver    User?       @relation("ApprovedLeave", fields: [approved_by], references: [userId])
}

model LeaveBalance {
  balance_id    Int       @id @default(autoincrement())
  user_id       Int
  leave_type    LeaveType
  entitled_days Int
  used_days     Int       @default(0)
  year          Int

  user          User      @relation(fields: [user_id], references: [userId])
}

// ─── Tasks & Allocation ───────────────────────────────────────

model Task {
  task_id           Int        @id @default(autoincrement())
  organisation_id   Int
  department_id     Int?
  created_by        Int
  required_skill_id Int?
  title             String     @db.VarChar(200)
  description       String?    @db.Text
  status            TaskStatus @default(PENDING)
  start_datetime    DateTime
  end_datetime      DateTime
  createdAt         DateTime   @default(now())

  organisation      Organisation     @relation(fields: [organisation_id], references: [organisation_id])
  department        Department?      @relation(fields: [department_id], references: [department_id])
  createdBy         User             @relation("CreatedTasks", fields: [created_by], references: [userId])
  requiredSkill     Skill?           @relation(fields: [required_skill_id], references: [skill_id])
  requiredSkills    TaskSkill[]
  assignments       TaskAssignment[]
  allocationHistory AllocationHistory[]
  updateRequests    TaskUpdateRequest[]
}

model TaskSkill {
  task_skill_id Int   @id @default(autoincrement())
  task_id       Int
  skill_id      Int

  task  Task  @relation(fields: [task_id],  references: [task_id], onDelete: Cascade)
  skill Skill @relation(fields: [skill_id], references: [skill_id])

  @@unique([task_id, skill_id])
}

model TaskAssignment {
  assignment_id   Int            @id @default(autoincrement())
  task_id         Int
  assigned_to     Int
  assigned_by     Int
  assignment_type AssignmentType
  assigned_at     DateTime       @default(now())

  task       Task @relation(fields: [task_id], references: [task_id])
  assignedTo User @relation("AssignedTo", fields: [assigned_to], references: [userId])
  assignedBy User @relation("AssignedBy", fields: [assigned_by], references: [userId])
}

model AllocationHistory {
  history_id Int      @id @default(autoincrement())
  task_id    Int
  user_id    Int
  changed_by Int
  action     String   @db.VarChar(100)
  timestamp  DateTime @default(now())

  task      Task @relation(fields: [task_id], references: [task_id])
  user      User @relation("UserAllocation", fields: [user_id], references: [userId])
  changedBy User @relation("ChangedByAllocation", fields: [changed_by], references: [userId])
}

model TaskUpdateRequest {
  request_id   Int                 @id @default(autoincrement())
  task_id      Int
  requested_by Int
  message      String?             @db.Text
  status       UpdateRequestStatus @default(PENDING)
  response     String?             @db.Text
  responded_at DateTime?
  created_at   DateTime            @default(now())

  task      Task @relation(fields: [task_id], references: [task_id])
  requester User @relation("UpdateRequestedBy", fields: [requested_by], references: [userId])
}

// ─── Shift Templates ──────────────────────────────────────────

model ShiftTemplate {
  shift_id        Int          @id @default(autoincrement())
  organisation_id Int
  name            String       @db.VarChar(100)
  start_time      String       @db.VarChar(5)
  end_time        String       @db.VarChar(5)
  created_at      DateTime     @default(now())

  organisation    Organisation      @relation(fields: [organisation_id], references: [organisation_id])
  assignments     ShiftAssignment[]
}

// A specific worker rostered to a shift template on a given date.
model ShiftAssignment {
  assignment_id   Int      @id @default(autoincrement())
  organisation_id Int
  user_id         Int
  shift_id        Int
  date            DateTime @db.Date
  created_at      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisation_id], references: [organisation_id])
  user         User          @relation(fields: [user_id], references: [userId])
  shift        ShiftTemplate @relation(fields: [shift_id], references: [shift_id])
}

// ─── Shift Change ─────────────────────────────────────────────

model ShiftChangeRequest {
  request_id      Int               @id @default(autoincrement())
  user_id         Int
  reviewed_by     Int?
  original_shift  DateTime
  requested_shift DateTime
  status          ShiftChangeStatus @default(PENDING)
  created_at      DateTime          @default(now())

  user     User  @relation("UserShiftChange", fields: [user_id], references: [userId])
  reviewer User? @relation("ReviewedShiftChange", fields: [reviewed_by], references: [userId])
}

// ─── Public / Unregistered ────────────────────────────────────

model UnregisteredUser {
  marketing_user_id Int      @id @default(autoincrement())
  organisation_id   Int?
  full_name         String?  @db.VarChar(150)
  email             String   @db.VarChar(150)
  password          String   @db.VarChar(255)
  role              String?  @db.VarChar(50)
  company_name      String?  @db.VarChar(150)
  position          String?  @db.VarChar(100)
  created_at        DateTime @default(now())

  organisation      Organisation? @relation(fields: [organisation_id], references: [organisation_id])
}

model ContactEnquiry {
  enquiry_id       Int       @id @default(autoincrement())
  user_id          Int?
  name             String?   @db.VarChar(100)
  email            String?   @db.VarChar(150)
  subject          String    @db.VarChar(200)
  message          String    @db.Text
  status           String    @default("OPEN") @db.VarChar(20)
  response_message String?   @db.Text
  responded_at     DateTime?
  created_at       DateTime  @default(now())
}

model Testimonial {
  testimonial_id Int      @id @default(autoincrement())
  user_id        Int
  rating         Int
  review_text    String   @db.Text
  profile_image  String?  @db.VarChar(500)
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [userId])
}

// ─── Feedback & Notifications ────────────────────────────────

model Feedback {
  feedback_id  Int            @id @default(autoincrement())
  user_id      Int
  message      String         @db.Text
  status       FeedbackStatus @default(OPEN)
  submitted_at DateTime       @default(now())

  user         User           @relation(fields: [user_id], references: [userId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  type        String   @db.VarChar(50)
  message     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   User     @relation(fields: [recipientId], references: [userId])
}

// ─── Landing Page Content ────────────────────────────────────

model LandingContent {
  id               Int      @id @default(autoincrement())
  hero_title       String   @db.VarChar(200)
  hero_subtitle    String?  @db.Text
  hero_image_url   String?  @db.VarChar(500)
  video_title      String?  @db.VarChar(200)
  video_subtitle   String?  @db.Text
  video_url        String?  @db.VarChar(500)
  plan_name        String?  @db.VarChar(100)
  plan_price       String?  @db.VarChar(50)
  plan_description String?  @db.Text
  updated_at       DateTime @updatedAt @default(now())
}

model LandingFeature {
  feature_id  Int      @id @default(autoincrement())
  icon        String?  @db.VarChar(10)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
}

model LandingTestimonial {
  testimonial_id Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  company        String?  @db.VarChar(150)
  rating         Int      @default(5)
  review_text    String   @db.Text
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
}

// ─── Profile Change Requests ─────────────────────────────────

model ProfileChangeRequest {
  request_id      Int       @id @default(autoincrement())
  user_id         Int
  field           String    @db.VarChar(100)
  requested_value String    @db.Text
  reason          String?   @db.Text
  status          String    @default("PENDING") @db.VarChar(20)
  reviewed_by     Int?
  review_note     String?   @db.Text
  reviewed_at     DateTime?
  created_at      DateTime  @default(now())

  user            User      @relation("ProfileChangeRequests", fields: [user_id], references: [userId])
  reviewer        User?     @relation("ProfileChangeReviews", fields: [reviewed_by], references: [userId])
}

// ─── Subscription Plans (Phase 3) ────────────────────────────

model SubscriptionPlan {
  plan_id       Int     @id @default(autoincrement())
  name          String  @db.VarChar(100)
  description   String? @db.Text
  price_monthly Decimal @db.Decimal(10, 2)
  price_annual  Decimal @db.Decimal(10, 2)
  max_users     Int?
  is_active     Boolean @default(true)

  features      PlanFeature[]
}

model PlanFeature {
  feature_id   Int    @id @default(autoincrement())
  plan_id      Int
  feature_name String @db.VarChar(200)

  plan         SubscriptionPlan @relation(fields: [plan_id], references: [plan_id])
}