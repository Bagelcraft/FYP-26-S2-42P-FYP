// ── 1. ADD this new join model (anywhere in the file, e.g. under Task) ──────
model TaskSkill {
  task_skill_id Int   @id @default(autoincrement())
  task_id       Int
  skill_id      Int

  task  Task  @relation(fields: [task_id],  references: [task_id], onDelete: Cascade)
  skill Skill @relation(fields: [skill_id], references: [skill_id])

  @@unique([task_id, skill_id])
}


